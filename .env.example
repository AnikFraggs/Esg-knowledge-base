# ESG Pipeline Environment Configuration
# Copy this file to .env and edit values

# --- Database ---
# SQLite (default, no setup needed):
DATABASE_URL=sqlite:///data/esg.db
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql://user:password@localhost:5432/esg_kb

# --- LLM (Ollama local) ---
OLLAMA_HOST=http://localhost:11434
LLM_MODEL=qwen3:8b
# Or vLLM/OpenAI-compatible endpoint:
# OPENAI_API_BASE=http://localhost:8000/v1
# OPENAI_API_KEY=not-needed
# LLM_MODEL=qwen3-8b

# --- Embeddings ---
EMBEDDER_MODEL=Qwen/Qwen3-Embedding-0.6B
# Alternative: BAAI/bge-m3
# EMBEDDER_MODEL=BAAI/bge-m3

# --- Reranker (optional, improves dedup) ---
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Alternative: Qwen/Qwen3-Reranker-0.6B

# --- Extraction ---
# Docling uses local models; no API key needed
# For PaddleOCR (optional):
# PADDLE_OCR_LANG=en

# --- Processing ---
# Confidence thresholds per source (0.0-1.0)
CONFIDENCE_XBRL=0.95
CONFIDENCE_XLSX=0.90
CONFIDENCE_PDF_TABLE=0.85
CONFIDENCE_PDF_TEXT=0.70
CONFIDENCE_OCR=0.50

# Dedup thresholds
DEDUP_EMBEDDING_THRESHOLD=0.85
DEDUP_RERANKER_THRESHOLD=0.80
DEDUP_SIGNATURE_MUST_MATCH=true

# Cross-source discrepancy tolerance (0.5% = 0.005)
DISCREPANCY_TOLERANCE=0.005

# YoY sanity ranges (multiplier from prior year)
YOY_MIN_MULTIPLIER=0.3
YOY_MAX_MULTIPLIER=3.0

# Job queue
JOB_WORKER_CONCURRENCY=2
JOB_POLL_INTERVAL_SECONDS=5

# Paths
DATA_DIR=data
RAW_DIR=data/raw
EXTRACTED_DIR=data/extracted
EXPORTS_DIR=data/exports

# Logging
LOG_LEVEL=INFO
